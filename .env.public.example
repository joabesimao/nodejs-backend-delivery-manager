# ⚠️ Valores de DEMONSTRAÇÃO para rodar localmente (docker-compose.public.yml).
# São públicos: nunca use em produção. Com NODE_ENV=production a API recusa
# este JWT_SECRET. Gere um segredo com: openssl rand -hex 32
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_NAME=CadClient
DB_USER=myuser
DB_PASSWORD=mypassword

DATABASE_URL=mysql://myuser:mypassword@mysql:3306/CadClient

JWT_SECRET=fastone_jwt_secret_public_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origens do frontend liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
