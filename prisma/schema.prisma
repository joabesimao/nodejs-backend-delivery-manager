generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String
  lastName String
  phone    String
  status   Boolean   @default(true)
  Register Register?
}

enum OrderStatus {
  actived
  delivered
  finished
}

model OrderDelivery {
  id            Int          @id @default(autoincrement())
  quantity      String
  amount        Float
  data          DateTime
  status        OrderStatus  @default(actived)
  Register      Register     @relation(fields: [registerId], references: [id])
  registerId    Int
  deliveryman   Deliveryman? @relation(fields: [deliverymanId], references: [id])
  deliverymanId Int?
  unitStore     UnitStore?   @relation(fields: [unitStoreId], references: [id])
  unitStoreId   Int?
}

model Address {
  id           Int       @id @default(autoincrement())
  street       String
  neighborhood String
  numberHouse  Int
  reference    String
  city         String
  register     Register?
}

model Register {
  id              Int             @id @default(autoincrement())
  client          Client          @relation(fields: [clientId], references: [id])
  clientId        Int             @unique
  address         Address         @relation(fields: [addressId], references: [id])
  addressId       Int             @unique
  orderDeliveryId Int?
  OrderDelivery   OrderDelivery[]
}

model City {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  neighborhoods Neighborhood[]
}

model UnitStore {
  id         Int             @id @default(autoincrement())
  name       String
  deliveries OrderDelivery[]
}

model Deliveryman {
  id         Int             @id @default(autoincrement())
  name       String
  lastName   String
  phone      String          @unique
  deliveries OrderDelivery[]
}

model Neighborhood {
  id     Int    @id @default(autoincrement())
  name   String
  cityId Int
  city   City   @relation(fields: [cityId], references: [id])
}
