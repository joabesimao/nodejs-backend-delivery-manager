generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Address {
  id           Int        @id @default(autoincrement())
  street       String
  neighborhood String
  numberHouse  Int
  reference    String
  city         String
  register     Register[]
}

model Client {
  id       Int        @id @default(autoincrement())
  name     String
  lastName String
  phone    String
  register Register[]
}

model Orderdelivery {
  id         Int      @id @default(autoincrement())
  registerId Int      @unique(map: "OrderDelivery_registerId_key")
  quantity   String
  amount     Float
  data       DateTime
  register   Register @relation(fields: [registerId], references: [id], map: "OrderDelivery_registerId_fkey")
}

model Register {
  id            Int            @id @default(autoincrement())
  clientId      Int
  addressId     Int
  orderdelivery Orderdelivery?
  address       Address        @relation(fields: [addressId], references: [id], map: "Register_addressId_fkey")
  client        Client         @relation(fields: [clientId], references: [id], map: "Register_clientId_fkey")

  @@index([addressId], map: "Register_addressId_fkey")
  @@index([clientId], map: "Register_clientId_fkey")
}
