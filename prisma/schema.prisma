generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  password    String
  role        AccountRole   @default(branch)
  unitStoreId Int?
  unitStore   UnitStore?    @relation(fields: [unitStoreId], references: [id])
  messages    ChatMessage[]
}

enum AccountRole {
  principal
  branch
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String
  lastName String
  cpf      String    @unique
  phone    String
  status   Boolean   @default(true)
  Register Register?
}

enum OrderStatus {
  actived
  delivered
  finished
}

model OrderDelivery {
  id            Int          @id @default(autoincrement())
  quantity      String
  amount        Float
  data          DateTime
  receivedAt    DateTime?    @default(now())
  finishedAt    DateTime?
  status        OrderStatus  @default(actived)
  Register      Register     @relation(fields: [registerId], references: [id])
  registerId    Int
  deliveryman   Deliveryman? @relation(fields: [deliverymanId], references: [id])
  deliverymanId Int?
  unitStore     UnitStore?   @relation(fields: [unitStoreId], references: [id])
  unitStoreId   Int?
}

model Address {
  id           Int       @id @default(autoincrement())
  street       String
  neighborhood String
  numberHouse  Int
  reference    String
  city         String
  register     Register?
}

model Register {
  id              Int             @id @default(autoincrement())
  client          Client          @relation(fields: [clientId], references: [id])
  clientId        Int             @unique
  address         Address         @relation(fields: [addressId], references: [id])
  addressId       Int             @unique
  orderDeliveryId Int?
  OrderDelivery   OrderDelivery[]
}

model City {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  neighborhoods Neighborhood[]
}

model UnitStore {
  id            Int             @id @default(autoincrement())
  name          String
  isMain        Boolean         @default(false)
  parentStoreId Int?
  parentStore   UnitStore?      @relation("UnitStoreHierarchy", fields: [parentStoreId], references: [id])
  children      UnitStore[]     @relation("UnitStoreHierarchy")
  deliveries    OrderDelivery[]
  accounts      Account[]
  messages      ChatMessage[]
}

model Deliveryman {
  id         Int             @id @default(autoincrement())
  name       String
  lastName   String
  phone      String          @unique
  deliveries OrderDelivery[]
}

model Neighborhood {
  id     Int    @id @default(autoincrement())
  name   String
  cityId Int
  city   City   @relation(fields: [cityId], references: [id])
}

model ChatMessage {
  id            Int       @id @default(autoincrement())
  unitStoreId   Int
  senderId      Int
  text          String?
  imageBase64   String?   @db.LongText
  imageMimeType String?
  createdAt     DateTime  @default(now())
  unitStore     UnitStore @relation(fields: [unitStoreId], references: [id])
  sender        Account   @relation(fields: [senderId], references: [id])

  @@index([unitStoreId, createdAt])
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Decimal @db.Decimal(10, 2)
  description String
  category    String
}
