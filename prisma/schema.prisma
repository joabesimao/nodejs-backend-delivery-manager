generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                       Int            @id @default(autoincrement())
  name                     String
  email                    String         @unique
  password                 String
  role                     AccountRole    @default(user)
  active                   Boolean        @default(true)
  unitStoreId              Int?
  unitStore                UnitStore?     @relation(fields: [unitStoreId], references: [id])
  messages                 ChatMessage[]
  notifications            Notification[]
  refreshTokenHash         String?        @db.VarChar(64)
  refreshTokenExpiresAt    DateTime?      @db.Timestamptz(3)
  previousRefreshTokenHash String?        @db.VarChar(64)
  refreshTokenRotatedAt    DateTime?      @db.Timestamptz(3)
}

enum AccountRole {
  admin
  gerente_estoque
  entregador
  user
}

model Client {
  id       Int       @id @default(autoincrement())
  name     String
  cpf      String    @unique
  phone    String
  status   Boolean   @default(true)
  Register Register?
}

enum OrderStatus {
  actived
  delivered
  finished
}

model OrderDelivery {
  id            Int          @id @default(autoincrement())
  quantity      String
  amount        Float
  data          DateTime     @db.Timestamptz(3)
  receivedAt    DateTime?    @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime?    @db.Timestamptz(3)
  status        OrderStatus  @default(actived)
  Register      Register     @relation(fields: [registerId], references: [id])
  registerId    Int
  deliveryman   Deliveryman? @relation(fields: [deliverymanId], references: [id])
  deliverymanId Int?
  unitStore     UnitStore?   @relation(fields: [unitStoreId], references: [id])
  unitStoreId   Int?
}

model Address {
  id           Int       @id @default(autoincrement())
  street       String
  neighborhood String
  numberHouse  Int
  reference    String
  city         String
  register     Register?
}

model Register {
  id              Int             @id @default(autoincrement())
  client          Client          @relation(fields: [clientId], references: [id])
  clientId        Int             @unique
  address         Address         @relation(fields: [addressId], references: [id])
  addressId       Int             @unique
  orderDeliveryId Int?
  OrderDelivery   OrderDelivery[]
}

model City {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  neighborhoods Neighborhood[]
}

model UnitStore {
  id            Int             @id @default(autoincrement())
  name          String
  isMain        Boolean         @default(false)
  parentStoreId Int?
  parentStore   UnitStore?      @relation("UnitStoreHierarchy", fields: [parentStoreId], references: [id])
  children      UnitStore[]     @relation("UnitStoreHierarchy")
  deliveries    OrderDelivery[]
  accounts      Account[]
  messages      ChatMessage[]
}

model Deliveryman {
  id                  Int             @id @default(autoincrement())
  name                String
  lastName            String
  numberQualification String          @unique
  phone               String          @unique
  cpf                 String?         @unique
  deliveries          OrderDelivery[]
  vehicles            Vehicle[]
  oilChangeLogs       OilChangeLog[]
  fuelRefills         FuelRefill[]
}

model Vehicle {
  id            Int            @id @default(autoincrement())
  plate         String         @unique
  model         String
  brand         String?
  deliverymanId Int?
  deliveryman   Deliveryman?   @relation(fields: [deliverymanId], references: [id])
  oilChangeLogs OilChangeLog[]
  fuelRefills   FuelRefill[]
}

model OilChangeConfig {
  id         Int      @id @default(autoincrement())
  intervalKm Int
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

model OilChangeLog {
  id            Int         @id @default(autoincrement())
  vehicleId     Int
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  deliverymanId Int
  deliveryman   Deliveryman @relation(fields: [deliverymanId], references: [id])
  km            Int
  nextChangeKm  Int
  changeDate    DateTime    @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([vehicleId, changeDate])
}

model FuelRefill {
  id            Int         @id @default(autoincrement())
  vehicleId     Int
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  deliverymanId Int
  deliveryman   Deliveryman @relation(fields: [deliverymanId], references: [id])
  km            Int
  previousKm    Int?
  kmDriven      Int?
  liters        Decimal     @db.Decimal(10, 2)
  pricePerLiter Decimal?    @db.Decimal(10, 3)
  totalValue    Decimal     @db.Decimal(10, 2)
  refillDate    DateTime    @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([vehicleId, refillDate])
}

model Neighborhood {
  id     Int    @id @default(autoincrement())
  name   String
  cityId Int
  city   City   @relation(fields: [cityId], references: [id])
}

model ChatMessage {
  id            Int       @id @default(autoincrement())
  unitStoreId   Int
  senderId      Int
  text          String?
  imageBase64   String?   @db.Text
  imageMimeType String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  unitStore     UnitStore @relation(fields: [unitStoreId], references: [id])
  sender        Account   @relation(fields: [senderId], references: [id])

  @@index([unitStoreId, createdAt])
}

model Product {
  id            Int                @id @default(autoincrement())
  name          String
  price         Decimal            @db.Decimal(10, 2)
  description   String
  category      String
  subcategory   String?
  brand         String?
  model         String?
  unit          String?
  barcode       String?            @unique
  status        Boolean            @default(true)
  notes         String?            @db.Text
  imageBase64   String?            @db.Text
  imageMimeType String?
  variations    ProductVariation[]
}

model ProductVariation {
  id        Int     @id @default(autoincrement())
  attribute String
  value     String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum NotificationType {
  chat_message
  oil_change_due
  oil_change_created
  fuel_refill_created
  admin_notice
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  recipient   Account          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String           @db.Text
  link        String?
  data        Json?
  dedupeKey   String?
  readAt      DateTime?        @db.Timestamptz(3)
  deletedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([recipientId, readAt, updatedAt])
  @@index([recipientId, dedupeKey])
}
