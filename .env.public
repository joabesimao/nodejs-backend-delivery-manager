# ⚠️ Valores de DEMONSTRAÇÃO para rodar localmente (docker-compose.public.yml).
# São públicos: nunca use em produção. Com NODE_ENV=production a API recusa
# este JWT_SECRET. Gere um segredo com: openssl rand -hex 32
PORT=3000

# Postgres local (docker-compose.public.yml). No Neon, use a connection string
# "pooled" (host com -pooler) em DATABASE_URL e a direta em DIRECT_URL.
DATABASE_URL=postgresql://myuser:mypassword@postgres:5432/CadClient
DIRECT_URL=postgresql://myuser:mypassword@postgres:5432/CadClient

JWT_SECRET=fastone_jwt_secret_public_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origens do frontend liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
